{
  "name": "@kiligzzz/dsh-kiligz-base",
  "version": "0.1.2",
  "description": "Unified DeepSeek Harness capability bundle with consistent UI for automation, skills, MCP, archives, appearance, vision, auto-continue, and sidebar tools.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "vendor",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiligzzz/dsh-kiligz-base.git"
  },
  "bugs": {
    "url": "https://github.com/kiligzzz/dsh-kiligz-base/issues"
  },
  "homepage": "https://github.com/kiligzzz/dsh-kiligz-base#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "automation",
    "mcp",
    "skill",
    "vision",
    "sidebar"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-attachment",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "npm run verify"
  },
  "dependencies": {
    "@michengai/dsh-automation": "0.1.34",
    "dsh-better-sidebar": "0.18.0",
    "dsh-client-auto-continue": "0.11.4",
    "dsh-vision-router": "2.1.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
