{
  "name": "@kiligzzz/dsh-kiligz-base",
  "version": "0.2.0",
  "description": "Unified DeepSeek Harness capability bundle with consistent UI for automation, skills, MCP, archives, appearance, and cross-model vision.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "vendor",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiligzzz/dsh-kiligz-base.git"
  },
  "bugs": {
    "url": "https://github.com/kiligzzz/dsh-kiligz-base/issues"
  },
  "homepage": "https://github.com/kiligzzz/dsh-kiligz-base#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "automation",
    "mcp",
    "skill",
    "vision"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-attachment",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify.mjs",
    "test:mcp": "node vendor/features/skill-mcp-manager/test/verify.mjs && node vendor/features/skill-mcp-manager/test/lazy-mcp.mjs && node vendor/features/skill-mcp-manager/test/oauth-broker.mjs && node vendor/features/skill-mcp-manager/test/skill-import.mjs && node vendor/features/skill-mcp-manager/test/skill-list.mjs && node vendor/features/skill-mcp-manager/test/skill-page.mjs",
    "test": "npm run verify && npm run test:mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@goodandready/dsh-vision-bridge": "github:GooDAnDReaDY/dsh-vision-bridge#22cbdbb41175b3c1447668627d851144cd5b10a8",
    "@michengai/dsh-automation": "0.1.40"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
